<Window x:Class="MiniBrowser.Views.ImportDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт данных" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource B.Window}">
    <StackPanel Margin="18,14,18,16">
        <TextBlock Text="Импорт данных из других браузеров" FontSize="15"
                   Foreground="{StaticResource T.Primary}"/>

        <TextBlock Text="Из какого браузера" Margin="0,14,0,4" FontSize="11"
                   Foreground="{StaticResource T.Muted}"/>
        <ComboBox x:Name="BrowserBox" DisplayMemberPath="Name"/>

        <TextBlock x:Name="NoBrowsersText" Text="Установленные браузеры не найдены"
                   Margin="0,8,0,0" FontSize="12" Visibility="Collapsed"
                   Foreground="{StaticResource T.Muted}"/>

        <TextBlock Text="Что импортировать" Margin="0,14,0,4" FontSize="11"
                   Foreground="{StaticResource T.Muted}"/>
        <CheckBox x:Name="BookmarksBox" Content="Закладки" IsChecked="True"
                  Foreground="{StaticResource T.Primary}"/>
        <CheckBox x:Name="LoginsBox" Content="Пароли" IsChecked="True" Margin="0,4,0,0"
                  Foreground="{StaticResource T.Primary}"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="ImportButton" Content="Начать импорт" MinWidth="130"
                    Style="{StaticResource FlatToolButton}" Click="Import_Click"/>
            <Button x:Name="DoneButton" Content="Готово" MinWidth="90" Margin="10,0,0,0"
                    Visibility="Collapsed" Click="Done_Click"/>
        </StackPanel>

        <TextBlock x:Name="ProgressText" Margin="0,10,0,0" FontSize="12"
                   Foreground="{StaticResource T.Muted}"/>
        <TextBlock x:Name="SummaryText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource T.Accent}"/>
        <!-- Причины пропусков: мастер-пароль, v20 и т.п. -->
        <StackPanel x:Name="NotesPanel" Margin="0,4,0,0"/>
    </StackPanel>
</Window>
