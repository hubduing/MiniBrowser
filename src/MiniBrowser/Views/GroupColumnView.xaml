<UserControl x:Class="MiniBrowser.Views.GroupColumnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

    <Border x:Name="Surface" Margin="0,0,6,6">
        <Border.Style>
            <!-- Фон колонки и рамка цели при перетаскивании: в одном стиле,
                 иначе Setter фона перекрыл бы триггер рамки. -->
            <Style TargetType="Border" BasedOn="{StaticResource GroupColumnSurface}">
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDropTarget,
                                RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource T.Accent}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Цветовая метка: читается и у свёрнутой группы -->
            <Border x:Name="ColorMark" Grid.Column="0"/>

            <DockPanel x:Name="ExpandedPanel" Grid.Column="1">
                <!-- Заголовок: сворачивание, имя, счётчик, закрыть. Захват мыши нужен и для
                     перетаскивания группы, поэтому фон — полупрозрачный подтон цвета группы. -->
                <Grid x:Name="Header" DockPanel.Dock="Top" Height="32" Margin="4,2,2,0"
                      PreviewMouseLeftButtonDown="Header_PreviewMouseDown"
                      PreviewMouseMove="Header_PreviewMouseMove"
                      PreviewMouseRightButtonDown="Header_PreviewMouseRightButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CollapseButton" Grid.Column="0" Content="▾"
                            Style="{StaticResource GroupHeaderButton}"
                            FontSize="13"
                            Click="Collapse_Click"
                            ToolTip="Свернуть группу"/>

                    <!-- Имя правится только двойным кликом: одиночный не должен
                         переименовывать группу случайно. -->
                    <Grid Grid.Column="1" Margin="6,0">
                        <TextBlock x:Name="NameText"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource T.Primary}"
                                   MouseLeftButtonUp="Name_Click"/>
                        <!-- Поле ввода поверх имени: отдельное окно-диалог для
                             переименования было бы тяжелее самой задачи. -->
                        <TextBox x:Name="RenameBox" Visibility="Collapsed"
                                 FontSize="14"
                                 KeyDown="RenameBox_KeyDown"
                                 LostFocus="RenameBox_LostFocus"/>
                    </Grid>

                    <TextBlock x:Name="Badge" Grid.Column="2" Style="{StaticResource GroupBadge}"/>

                    <Button Grid.Column="3" Content="✕"
                            Style="{StaticResource CloseTabButton}"
                            Click="CloseGroup_Click"
                            ToolTip="Закрыть все вкладки группы"/>
                </Grid>

                <!-- Вкладки — строки на всю ширину группы, одна под другой. -->
                <ItemsControl x:Name="TabsItems"
                              HorizontalContentAlignment="Stretch"
                              PreviewMouseLeftButtonDown="Tab_PreviewMouseDown"
                              PreviewMouseRightButtonDown="Tab_PreviewMouseRightButtonDown"
                              PreviewMouseMove="Tab_PreviewMouseMove">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,2,4,2" Padding="10,7"
                                    Cursor="Hand" CornerRadius="6"
                                    BorderThickness="0,0,0,2"
                                    MouseLeftButtonUp="Tab_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource B.Hover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource B.Content}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource T.Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕"
                                            Style="{StaticResource CloseTabButton}"
                                            Click="Close_Click"
                                            ToolTip="Закрыть вкладку"/>
                                    <TextBlock Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource T.Primary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource T.Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Свёрнутая группа: одна строка на всю ширину — имя и счётчик,
                 вкладки скрыты. Клик разворачивает её обратно. -->
            <Grid x:Name="CollapsedPanel"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  MinHeight="30"
                  Margin="10,0,8,0"
                  Visibility="Collapsed"
                  Cursor="Hand"
                  MouseLeftButtonUp="Collapsed_Click">
                <Grid.ColumnDefinitions>
                    <!-- Имя растягивается на всю строку — длинное режется
                         многоточием, а не вылезает за кромку. -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CollapsedName"
                           Grid.Column="0"
                           FontSize="14"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource T.Primary}"/>
                <TextBlock x:Name="CollapsedBadge" Grid.Column="1"
                           Style="{StaticResource GroupBadge}"
                           Margin="8,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
