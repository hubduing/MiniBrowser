<UserControl x:Class="MiniBrowser.Views.MenuDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyDown="Drawer_KeyDown"
             Visibility="Collapsed" IsHitTestVisible="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <!-- Обычный Grid в дереве окна, не Popup: слои Popup не пересекаются с WebView2. -->
    <Grid x:Name="Root">
        <!-- Затемнение на всё окно; клик по нему закрывает панель. -->
        <Border x:Name="Dim" Background="#80000000" Opacity="0"
                MouseLeftButtonDown="Dim_MouseLeftButtonDown"/>

        <!-- Панель 360px слева; MaxWidth прижимает её к узкому окну, иначе она вылезет за край. -->
        <Border x:Name="Panel" Background="{StaticResource B.Toolbar}"
                BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0"
                HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0"
                Width="360" MaxWidth="{Binding ActualWidth, ElementName=Root}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" X="-360"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <!-- Нижнего колонтитула у панели нет; строка оставлена по брифу. -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="✕" HorizontalAlignment="Right" Margin="8,8,8,0"
                        Style="{StaticResource FlatToolButton}" ToolTip="Закрыть (Esc)"
                        Click="Panel_Close_Click"/>

                <TabControl Grid.Row="1" x:Name="Tabs" Margin="8" Style="{StaticResource DrawerTabControl}">

                    <TabItem Header="Закладки" Style="{StaticResource DrawerTabItem}">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Поиск общий для обеих вкладок: одно поле SearchText в VM. -->
                                <TextBox Grid.Column="0" Style="{StaticResource AddressBox}" AutomationProperties.AutomationId="DrawerSearchBox"
                                         ToolTip="Поиск по закладкам и истории"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="✕" Margin="6,0,0,0"
                                        Style="{StaticResource FlatToolButton}" ToolTip="Очистить поиск"
                                        Command="{Binding ClearSearchCommand}"/>
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11"
                                       Foreground="{StaticResource T.Muted}"
                                       Text="{Binding BookmarksCountText}"/>
                            <Grid>
                                <ListBox x:Name="BookmarksList" Style="{StaticResource DrawerListBox}"
                                         ItemContainerStyle="{StaticResource DrawerListBoxItem}"
                                         ItemsSource="{Binding Bookmarks}"
                                         MouseDoubleClick="List_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Подсказка висит на строке: одиночный клик только выделяет её,
                                                 без объяснения двойного клика панель кажется сломанной. -->
                                            <DockPanel LastChildFill="True" Margin="2" ToolTip="Двойной клик — открыть">
                                                <!-- Кнопка видит строку, а не VM: к команде дотягиваемся через ListBox. -->
                                                <Button DockPanel.Dock="Right" Content="✕" VerticalAlignment="Center"
                                                        Style="{StaticResource FlatToolButton}"
                                                        ToolTip="Удалить закладку"
                                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               Foreground="{StaticResource T.Primary}"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="{Binding Url}" FontSize="11"
                                                               Foreground="{StaticResource T.Muted}"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <!-- «Ничего не найдено» важнее «пусто» (контракт Task 5). -->
                                <TextBlock Text="Ничего не найдено" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{StaticResource T.Muted}" IsHitTestVisible="False"
                                           Visibility="{Binding BookmarksNoResults, Converter={StaticResource BoolToVis}}">
                                </TextBlock>
                                <TextBlock Text="Закладок пока нет" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{StaticResource T.Muted}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasBookmarks}" Value="False"/>
                                                        <Condition Binding="{Binding BookmarksNoResults}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="История" Style="{StaticResource DrawerTabItem}">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource AddressBox}" AutomationProperties.AutomationId="DrawerSearchBox"
                                         ToolTip="Поиск по закладкам и истории"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="✕" Margin="6,0,0,0"
                                        Style="{StaticResource FlatToolButton}" ToolTip="Очистить поиск"
                                        Command="{Binding ClearSearchCommand}"/>
                            </Grid>
                            <!-- Первым к низу прибит счётчик, кнопка ложится выше него. -->
                            <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11"
                                       Foreground="{StaticResource T.Muted}"
                                       Text="{Binding HistoryCountText}"/>
                            <Button DockPanel.Dock="Bottom" Content="Очистить историю" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Style="{StaticResource FlatToolButton}"
                                    Command="{Binding ClearHistoryCommand}"/>
                            <Grid>
                                <ListBox x:Name="HistoryList" Style="{StaticResource DrawerListBox}"
                                         ItemContainerStyle="{StaticResource DrawerListBoxItem}"
                                         ItemsSource="{Binding History}"
                                         MouseDoubleClick="List_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Подсказка висит на строке: одиночный клик только выделяет её,
                                                 без объяснения двойного клика панель кажется сломанной.
                                                 Отдельного удаления записей нет: только ClearHistory целиком. -->
                                            <StackPanel Margin="2" ToolTip="Двойной клик — открыть">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           Foreground="{StaticResource T.Primary}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding Url}" FontSize="11"
                                                           Foreground="{StaticResource T.Muted}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{StaticResource T.Muted}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Ничего не найдено" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{StaticResource T.Muted}" IsHitTestVisible="False"
                                           Visibility="{Binding HistoryNoResults, Converter={StaticResource BoolToVis}}">
                                </TextBlock>
                                <TextBlock Text="Записей пока нет" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{StaticResource T.Muted}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasHistory}" Value="False"/>
                                                        <Condition Binding="{Binding HistoryNoResults}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Настройки" Style="{StaticResource DrawerTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Масштаб" Margin="0,4,0,4" FontSize="11"
                                           Foreground="{StaticResource T.Muted}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="ZoomSlider" Grid.Column="0" Minimum="50" Maximum="200" TickFrequency="5"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Value="{Binding Settings.Current.ZoomPercent, Mode=TwoWay}"
                                            ValueChanged="ZoomSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource T.Primary}"
                                               Text="{Binding Settings.Current.ZoomPercent, StringFormat={}{0:0}%}"/>
                                </Grid>

                                <TextBlock Text="Размер шрифта" Margin="0,12,0,4" FontSize="11"
                                           Foreground="{StaticResource T.Muted}"/>
                                <!-- Выбор строкой через Tag: привязка double без конвертера невозможна. -->
                                <ComboBox x:Name="FontSizeBox" SelectionChanged="FontSizeBox_SelectionChanged">
                                    <ComboBoxItem Content="13" Tag="13"/>
                                    <ComboBoxItem Content="16" Tag="16"/>
                                    <ComboBoxItem Content="20" Tag="20"/>
                                </ComboBox>

                                <TextBlock Text="Размер окна" Margin="0,12,0,4" FontSize="11"
                                           Foreground="{StaticResource T.Muted}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="1024×640" Style="{StaticResource FlatToolButton}"
                                            Command="{Binding SetWindowSizeCommand}" CommandParameter="1024,640"/>
                                    <Button Content="1200×800" Style="{StaticResource FlatToolButton}" Margin="6,0,0,0"
                                            Command="{Binding SetWindowSizeCommand}" CommandParameter="1200,800"/>
                                    <Button Content="1600×1000" Style="{StaticResource FlatToolButton}" Margin="6,0,0,0"
                                            Command="{Binding SetWindowSizeCommand}" CommandParameter="1600,1000"/>
                                </StackPanel>
                                <!-- Отдельного RememberSize в спеке нет: флагом служит WindowMaximized. -->
                                <CheckBox x:Name="RememberSizeBox" Click="RememberSizeBox_Click" Content="Запомнить размер окна" Margin="0,8,0,0"
                                          Foreground="{StaticResource T.Primary}"
                                          IsChecked="{Binding Settings.Current.WindowMaximized, Mode=TwoWay}"/>

                                <TextBlock Text="Домашняя страница" Margin="0,12,0,4" FontSize="11"
                                           Foreground="{StaticResource T.Muted}"/>
                                <TextBox x:Name="HomeUrlBox" Style="{StaticResource AddressBox}"
                                         Text="{Binding Settings.Current.HomeUrl, Mode=TwoWay}"/>

                                <TextBlock Text="Поисковая система" Margin="0,12,0,4" FontSize="11"
                                           Foreground="{StaticResource T.Muted}"/>
                                <!-- Имя движка в URL-шаблон переводит code-behind, как у шрифта. -->
                                <ComboBox x:Name="EngineBox" ItemsSource="{Binding SearchEngines}"
                                          SelectionChanged="EngineBox_SelectionChanged"/>

                                <CheckBox x:Name="StatusBarBox" Content="Показывать строку состояния" Margin="0,12,0,0"
                                          Foreground="{StaticResource T.Primary}"
                                          IsChecked="{Binding Settings.Current.ShowStatusBar, Mode=TwoWay}"
                                          Click="StatusBarBox_Click"/>

                                <TextBlock Text="Реклама" Margin="0,12,0,4" FontSize="11"
                                           Foreground="{StaticResource T.Muted}"/>
                                <!-- Глобальный выключатель. Отдельные отключения по сайту
                                     делает щит в тулбаре (Ctrl+Shift+A) — они хранятся
                                     в белом списке, который этот флажок не трогает. -->
                                <CheckBox x:Name="AdBlockBox" Content="Блокировать рекламу и трекеры" Margin="0,0,0,4"
                                          Foreground="{StaticResource T.Primary}"
                                          IsChecked="{Binding Settings.Current.AdBlockEnabled, Mode=TwoWay}"
                                          Click="AdBlockBox_Click"/>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Сбросить список" Margin="6,0,0,0"
                                            Style="{StaticResource FlatToolButton}"
                                            ToolTip="Снова блокировать рекламу на всех сайтах"
                                            Command="{Binding ClearAdBlockHostsCommand}"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource T.Muted}"
                                               Text="{Binding AdBlockDisabledHostsText}"/>
                                </DockPanel>

                                <Button Content="Сбросить настройки" Margin="0,12,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource FlatToolButton}"
                                        Command="{Binding ResetSettingsCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
