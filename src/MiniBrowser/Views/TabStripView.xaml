<UserControl x:Class="MiniBrowser.Views.TabStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#EFEFEF" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="4,3">
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Left"
                    Content="+"
                    Width="30" Margin="0,0,4,0"
                    Click="NewTab_Click"
                    ToolTip="Новая вкладка (Ctrl+T)"/>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Padding="0">
                <ItemsControl x:Name="TabsItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TabBorder"
                                    Margin="1,0" Padding="10,6"
                                    Cursor="Hand"
                                    BorderThickness="1,1,1,0"
                                    MouseLeftButtonUp="Tab_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E4E4E4"/>
                                        <Setter Property="BorderBrush" Value="#C0C0C0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#9A9A9A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}"
                                               MaxWidth="170"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <Button Content="✕"
                                            Width="17" Height="17"
                                            Margin="8,0,0,0" Padding="0"
                                            FontSize="9"
                                            Click="Close_Click"
                                            ToolTip="Закрыть вкладку (Ctrl+W)"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
