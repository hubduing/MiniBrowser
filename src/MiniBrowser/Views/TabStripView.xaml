<UserControl x:Class="MiniBrowser.Views.TabStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MiniBrowser.Views">

    <Border Background="{StaticResource B.TabStrip}" BorderBrush="{StaticResource B.Border}"
            BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,2">
                <Button Content="+ Группа"
                        Style="{StaticResource FlatToolButton}"
                        Click="NewGroup_Click"
                        ToolTip="Создать группу вкладок"/>
                <Button Content="+ Вкладка"
                        Style="{StaticResource FlatToolButton}"
                        Click="NewTab_Click"
                        ToolTip="Новая вкладка в активной группе (Ctrl+T)"/>
            </StackPanel>

            <!-- Колонки групп переносятся по строкам: мест в полосе на десяток
                 групп не хватает почти никогда. -->
            <ScrollViewer x:Name="StripScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="4,0,4,4"
                          DragOver="Strip_DragOver"
                          DragLeave="Strip_DragLeave"
                          Drop="Strip_Drop">
                <ItemsControl x:Name="ColumnsItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:GroupColumnView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>