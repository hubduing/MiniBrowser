<UserControl x:Class="MiniBrowser.Views.ToolbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource B.Toolbar}" BorderBrush="{StaticResource B.Border}"
            BorderThickness="0,0,0,1" Padding="8,6">
        <DockPanel LastChildFill="True">

            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="BackButton" Content="◀" Click="Back_Click"
                        Style="{StaticResource FlatToolButton}" ToolTip="Назад (Alt+←)"/>
                <Button x:Name="ForwardButton" Content="▶" Click="Forward_Click"
                        Style="{StaticResource FlatToolButton}" ToolTip="Вперёд (Alt+→)"/>
                <!-- Одна кнопка на оба действия: во время загрузки это «стоп»,
                     на settled-странице — «обновить». Как в Chrome/Edge/Firefox. -->
                <Button x:Name="ReloadStopButton" Content="⟳" Click="ReloadStop_Click"
                        Style="{StaticResource FlatToolButton}" ToolTip="Обновить (Ctrl+R)"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyButton" Content="⧉" Click="Copy_Click"
                        Style="{StaticResource FlatToolButton}" ToolTip="Скопировать адрес"/>
                <Button Content="☆" Click="Bookmark_Click"
                        Style="{StaticResource FlatToolButton}" ToolTip="Добавить в закладки (Ctrl+D)"/>
                <!-- Щит: активный стиль читается как «блокировка на этом сайте»,
                     приглушённый — как «здесь рекламу не блокируем». -->
                <Button x:Name="AdBlockButton" Content="⛊" Click="AdBlock_Click"
                        Style="{StaticResource FlatToolButton}"
                        ToolTip="Блокировать рекламу на этом сайте (Ctrl+Shift+A)"/>
                <Button x:Name="MenuButton" Content="☰" Click="Menu_Click"
                        Style="{StaticResource FlatToolButton}" ToolTip="Меню (Ctrl+M)"/>
            </StackPanel>

            <TextBox x:Name="AddressBox"
                     Margin="10,0"
                     Style="{StaticResource AddressBox}"
                     PreviewMouseLeftButtonDown="Address_PreviewMouseLeftButtonDown"
                     GotKeyboardFocus="Address_GotKeyboardFocus"
                     LostKeyboardFocus="Address_LostKeyboardFocus"
                     TextChanged="Address_TextChanged"
                     KeyDown="Address_KeyDown"/>
        </DockPanel>
    </Border>
</UserControl>
