<UserControl x:Class="MiniBrowser.Views.ToolbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource B.Toolbar}" BorderBrush="{StaticResource B.Border}"
            BorderThickness="0,0,0,1" Padding="8,6">
        <DockPanel LastChildFill="True">

            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="BackButton" Content="◀" Click="Back_Click"
                        Style="{StaticResource FlatToolButton}" ToolTip="Назад (Alt+←)"/>
                <Button x:Name="ForwardButton" Content="▶" Click="Forward_Click"
                        Style="{StaticResource FlatToolButton}" ToolTip="Вперёд (Alt+→)"/>
                <Button Content="⟳" Click="Refresh_Click"
                        Style="{StaticResource FlatToolButton}" ToolTip="Обновить (Ctrl+R)"/>
                <Button Content="✕" Click="Stop_Click"
                        Style="{StaticResource FlatToolButton}" ToolTip="Остановить загрузку"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="☆" Click="Bookmark_Click"
                        Style="{StaticResource FlatToolButton}" ToolTip="Добавить в закладки (Ctrl+D)"/>
                <Button x:Name="MenuButton" Content="☰" Click="Menu_Click"
                        Style="{StaticResource FlatToolButton}" ToolTip="Закладки и история">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="Menu" Opened="Menu_Opened"/>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>

            <TextBox x:Name="AddressBox"
                     Margin="10,0"
                     Style="{StaticResource AddressBox}"
                     GotKeyboardFocus="Address_GotKeyboardFocus"
                     LostKeyboardFocus="Address_LostKeyboardFocus"
                     KeyDown="Address_KeyDown"/>
        </DockPanel>
    </Border>
</UserControl>
