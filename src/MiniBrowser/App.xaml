<Application x:Class="MiniBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- ==== Палитра тёмной темы ==== -->
        <SolidColorBrush x:Key="B.Window"   Color="#FF202024"/>
        <SolidColorBrush x:Key="B.Toolbar"  Color="#FF2A2A31"/>
        <SolidColorBrush x:Key="B.TabStrip" Color="#FF232329"/>
        <SolidColorBrush x:Key="B.Content"  Color="#FF1B1B1F"/>
        <SolidColorBrush x:Key="B.Status"   Color="#FF17171B"/>
        <SolidColorBrush x:Key="B.Border"   Color="#FF3A3A43"/>
        <SolidColorBrush x:Key="B.Hover"    Color="#FF383841"/>
        <SolidColorBrush x:Key="B.Pressed"  Color="#FF47474F"/>
        <SolidColorBrush x:Key="B.TabIdle"  Color="#FF2E2E36"/>
        <SolidColorBrush x:Key="B.Address"  Color="#FF1D1D22"/>
        <SolidColorBrush x:Key="T.Primary"  Color="#FFE7E7EC"/>
        <SolidColorBrush x:Key="T.Muted"    Color="#FF9A9AA6"/>
        <SolidColorBrush x:Key="T.Accent"   Color="#FF6EA8F8"/>

        <!-- ==== Плоская кнопка панели инструментов ==== -->
        <Style x:Key="FlatToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource T.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== Кнопка закрытия вкладки ==== -->
        <Style x:Key="CloseTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource T.Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Pressed}"/>
                                <Setter Property="Foreground" Value="{StaticResource T.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFB33A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== Адресная строка ==== -->
        <Style x:Key="AddressBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource B.Address}"/>
            <Setter Property="Foreground" Value="{StaticResource T.Primary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource T.Primary}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource T.Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <!-- Подсказку видно только в пустом поле; ввод её не перехватывает -->
                                <TextBlock x:Name="Hint"
                                           Text="Поиск или адрес"
                                           Foreground="{StaticResource T.Muted}"
                                           FontSize="13"
                                           Margin="12,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF55555F"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource T.Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FF22222A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== Тёмное контекстное меню ==== -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource B.Toolbar}"/>
            <Setter Property="Foreground" Value="{StaticResource T.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PlacementTarget="{TemplateBinding PlacementTarget}"
                               Placement="{TemplateBinding Placement}"
                               HorizontalOffset="{TemplateBinding HorizontalOffset}"
                               VerticalOffset="{TemplateBinding VerticalOffset}"
                               PopupAnimation="Fade">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    Margin="6" MaxWidth="480" MaxHeight="620"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== Панель меню: список закладок/истории ==== -->
        <Style x:Key="DrawerListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource T.Primary}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- Строка списка: скругление и подсветка как у MenuItem, без них список выглядит мёртвым. -->
        <Style x:Key="DrawerListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource T.Primary}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== Панель меню: вкладки ==== -->
        <Style x:Key="DrawerTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="TabStripPlacement" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <!-- Та же рамка, что у ContextMenu; заголовка у панели нет. -->
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <DockPanel>
                                <TabPanel DockPanel.Dock="Top" IsItemsHost="True"
                                          Background="Transparent" Margin="0,0,0,4"/>
                                <!-- Без ScrollViewer вокруг содержимого: он давал бесконечную
                                     высоту, и прибитые к низу счётчик и кнопки уезжали за край.
                                     Списки скроллятся сами (ListBox), у настроек свой ScrollViewer. -->
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DrawerTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource B.TabIdle}"/>
            <Setter Property="Foreground" Value="{StaticResource T.Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,7"/>
            <!-- Без Focusable=False: нефокусируемый TabItem не переключается кликом мыши,
                 а клавиатурная навигация по вкладкам тоже нужна. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource T.Primary}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.TabIdle}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource T.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource T.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                Padding="11,7" SnapsToDevicePixels="True">
                            <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource B.Border}" Margin="7,5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
